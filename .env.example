ANTHROPIC_API_KEY=your-api-key-here
EP_DATA_DIR=./data
EP_DB_PATH=./data/ep_news.db
EP_CHROMA_PATH=./data/chroma
EP_MODEL=claude-haiku-4-5
EP_MIN_SCORE=4

# ── LangSmith observability (optional) ──────────────────────────────────────
# Get your API key at https://smith.langchain.com/
# When set, every retrieve + generate step is traced automatically.
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ep-news-ai

# ── Groq Cloud LLM (optional — replaces Ollama for cloud deployment) ─────────
# Get a free API key at https://console.groq.com/
# When set, Groq is used for all LLM calls (chat, reflection, PDF extraction).
# Fallback: Ollama local (OLLAMA_MODEL=llama3.1:latest) when key is absent.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# ── Gemini Flash vision (optional) ──────────────────────────────────────────
# Used as fallback for image-based / scanned PDFs that pdfplumber can't read.
# Get a free API key at https://aistudio.google.com/apikey (1500 req/day free)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
VISION_MAX_PAGES=4

# ── Chartink breakout fetcher ─────────────────────────────────────────────────
CHARTINK_EMAIL=your_chartink_email@example.com
CHARTINK_PASSWORD=your_chartink_password

# ── Admin API key (optional) ──────────────────────────────────────────────────
# When set, POST /api/brief/generate and POST/DELETE /api/watchlist require
# the header:  X-Api-Key: <your key>
# Leave empty to disable auth (dev/local use only).
EP_ADMIN_KEY=

# ── Performance ───────────────────────────────────────────────────────────────
# Force ChromaDB's ONNX embedding to CPU so Ollama keeps full VRAM on 6GB GPUs.
# Remove or set to "cuda" to use GPU embeddings (faster but competes with Ollama).
ONNX_DEVICE=cpu
