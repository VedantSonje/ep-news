ANTHROPIC_API_KEY=your-api-key-here
EP_DATA_DIR=./data
EP_DB_PATH=./data/ep_news.db
EP_CHROMA_PATH=./data/chroma
EP_MODEL=claude-haiku-4-5
EP_MIN_SCORE=4

# ── LangSmith observability (optional) ──────────────────────────────────────
# Get your API key at https://smith.langchain.com/
# When set, every retrieve + generate step is traced automatically.
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ep-news-ai
